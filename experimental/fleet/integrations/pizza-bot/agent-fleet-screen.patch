+  title: "hello",
+  context: null,
+  messages: [
+    { id: "c1:0", role: "user", text: "hello there", at: NOW - 5_000 },
+    { id: "c1:1", role: "assistant", text: "General Kenobi", at: NOW - 4_000 },
+  ],
+  pending: false,
+  error: null,
+  createdAt: NOW - 5_000,
+  updatedAt: NOW - 4_000,
+};
+
+const model: FleetModel = {
