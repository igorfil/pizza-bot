+import { describe, expect, it } from "vitest";
+import type { FleetModel, FleetTask } from "./fleet-types.js";
+import { activeRun, ago, artifactsNewestFirst, defaultInput, duration, inboxOf, runnerHealth, runnerLocation, runsOf, runStrip, runTitle } from "./fleet-view-model.js";
+
+const NOW = 1_000_000;
+
+const KEY = "ec2/dadjokes";
+
+const task = (overrides: Partial<FleetTask>): FleetTask => ({
+  id: "t1",
+  runner: "ec2",
+  agent: "dadjokes",
+  prompt: "kubernetes",
+  state: "completed",
+  statusText: "jokes delivered",
+  artifacts: [],
+  createdAt: NOW - 60_000,
+  updatedAt: NOW - 55_000,
+  ...overrides,
+});
+
+const model = (tasks: FleetTask[], example = "penguins"): FleetModel => ({
+  now: NOW,
+  runners: {
+    ec2: {
+      name: "ec2",
+      url: "http://127.0.0.1:9471",
+      status: "healthy",
+      failures: 0,
+      nextCheckAt: NOW + 15_000,
+      lastSeenAt: NOW - 3_000,
+      lastError: null,
+      location: null,
+    },
+  },
+  agents: {
+    [KEY]: {
+      key: KEY,
+      runner: "ec2",
+      id: "dadjokes",
+      name: "Dad jokes",
+      description: "Dad jokes",
+      input: { label: "Topic", hint: "what about", example },
+      schedule: null,
+    },
+  },
+  tasks: Object.fromEntries(tasks.map((t) => [t.id, t])),
+  notifications: [],
+});
+
+describe("runsOf", () => {
+  it("lists an agent's runs newest first", () => {
+    const m = model([task({ id: "old", createdAt: NOW - 90_000 }), task({ id: "new", createdAt: NOW - 10_000 })]);
+    expect(runsOf(m, KEY).map((t) => t.id)).toEqual(["new", "old"]);
+  });
+
+  it("excludes other agents' runs", () => {
+    expect(runsOf(model([task({ agent: "other" })]), KEY)).toEqual([]);
+  });
+
+  it("excludes the same agent id on another runner", () => {
+    expect(runsOf(model([task({ runner: "laptop" })]), KEY)).toEqual([]);
+  });
+});
+
+describe("activeRun", () => {
+  it("returns the run that has not finished", () => {
+    const m = model([task({ id: "done" }), task({ id: "live", state: "working", createdAt: NOW - 1_000 })]);
+    expect(activeRun(m, KEY)?.id).toBe("live");
+  });
+
+  it("is undefined when every run has finished", () => {
+    expect(activeRun(model([task({ state: "failed" })]), KEY)).toBeUndefined();
+  });
+});
+
+describe("defaultInput", () => {
+  it("prefers the last prompt over the card example", () => {
+    expect(defaultInput(model([task({ prompt: "coffee" })]), KEY)).toBe("coffee");
+  });
+
+  it("falls back to the card example when there are no runs", () => {
+    expect(defaultInput(model([]), KEY)).toBe("penguins");
+  });
+
+  it("is empty without runs or examples", () => {
+    expect(defaultInput(model([], ""), KEY)).toBe("");
+  });
+});
+
+describe("artifactsNewestFirst", () => {
+  it("puts the last artifact first", () => {
+    const t = task({
+      artifacts: [
+        { id: "metrics", name: "metrics", text: "raw" },
+        { id: "summary", name: "summary", text: "ok" },
+      ],
+    });
+    expect(artifactsNewestFirst(t).map((a) => a.id)).toEqual(["summary", "metrics"]);
+  });
+});
+
+describe("inboxOf", () => {
+  it("lists unread finished runs newest first", () => {
+    const m = model([task({ id: "old", updatedAt: NOW - 90_000 }), task({ id: "new", updatedAt: NOW - 1_000 })]);
+    expect(inboxOf(m).map((t) => t.id)).toEqual(["new", "old"]);
+  });
+
+  it("drops acknowledged runs", () => {
+    expect(inboxOf(model([task({ ackedAt: NOW })]))).toEqual([]);
+  });
+
+  it("drops runs still in progress", () => {
+    expect(inboxOf(model([task({ state: "working" })]))).toEqual([]);
+  });
+});
+
+describe("runTitle", () => {
+  it("combines the agent's input label with the prompt", () => {
+    const m = model([]);
+    expect(runTitle(m, task({ prompt: "coffee" }))).toBe("Topic: coffee");
+  });
+
+  it("falls back to a report title without a prompt", () => {
+    expect(runTitle(model([]), task({ prompt: "" }))).toBe("Your dad jokes");
+  });
+});
+
+describe("runStrip", () => {
+  it("orders the last runs oldest to newest", () => {
+    const m = model([task({ id: "a", createdAt: NOW - 30_000 }), task({ id: "b", createdAt: NOW - 10_000 })]);
+    expect(runStrip(m, KEY).map((t) => t.id)).toEqual(["a", "b"]);
+  });
+
+  it("keeps at most the last ten runs", () => {
+    const many = Array.from({ length: 14 }, (_, i) => task({ id: `t${i}`, createdAt: NOW - i * 1_000 }));
+    expect(runStrip(model(many), KEY)).toHaveLength(10);
+  });
+});
+
+describe("runnerLocation", () => {
+  it("uses the location the runner reports", () => {
+    expect(runnerLocation({ ...model([]).runners.ec2!, location: "EC2 us-west-2" })).toBe("EC2 us-west-2");
+  });
+
+  it("falls back to the runner's host", () => {
+    expect(runnerLocation({ ...model([]).runners.ec2!, location: null })).toBe("127.0.0.1:9471");
+  });
+});
+
+describe("formatting", () => {
+  it.each([
+    [2_000, "just now"],
+    [42_000, "42s ago"],
+    [5 * 60_000, "5m ago"],
+    [3 * 3_600_000, "3h ago"],
+    [2 * 86_400_000, "2d ago"],
+  ])("ago(%i ms) is %s", (elapsed, expected) => {
+    expect(ago(NOW, NOW - elapsed)).toBe(expected);
+  });
+
+  it.each([
+    [6_000, "6s"],
+    [62_000, "1m 02s"],
+  ])("duration(%i ms) is %s", (ms, expected) => {
+    expect(duration(ms)).toBe(expected);
+  });
+
+  it("shows the retry countdown for an unreachable runner", () => {
+    const m = model([]);
+    const runner = { ...m.runners.ec2!, status: "unreachable" as const, nextCheckAt: NOW + 8_000 };
+    expect(runnerHealth(m, runner)).toBe("retry in 8s");
+  });
+});
diff --git a/apps/web/src/components/fleet/fleet-view-model.ts b/apps/web/src/components/fleet/fleet-view-model.ts
new file mode 100644
index 0000000..f8c714e
--- /dev/null
+++ b/apps/web/src/components/fleet/fleet-view-model.ts
@@ -0,0 +1,108 @@
+import type { FleetAgent, FleetChat, FleetModel, FleetRunner, FleetTask, FleetTaskState } from "./fleet-types.js";
+
+const TERMINAL: ReadonlySet<FleetTaskState> = new Set(["completed", "failed", "canceled", "rejected", "lost"]);
+
+export const isFinished = (task: FleetTask): boolean => TERMINAL.has(task.state);
+
+export const taskAgentKey = (task: FleetTask): string => `${task.runner}/${task.agent}`;
+
+export const agentsOf = (model: FleetModel): FleetAgent[] =>
+  Object.values(model.agents ?? {}).sort((a, b) => a.runner.localeCompare(b.runner) || a.name.localeCompare(b.name));
+
+export const agentOfTask = (model: FleetModel, task: FleetTask): FleetAgent | undefined => model.agents?.[taskAgentKey(task)];
+
+export const agentName = (model: FleetModel, task: FleetTask): string => agentOfTask(model, task)?.name ?? task.agent;
+
+export const runsOf = (model: FleetModel, agentKey: string): FleetTask[] =>
+  Object.values(model.tasks)
+    .filter((t) => taskAgentKey(t) === agentKey)
+    .sort((a, b) => b.createdAt - a.createdAt);
+
+export const activeRun = (model: FleetModel, agentKey: string): FleetTask | undefined =>
+  runsOf(model, agentKey).find((t) => !isFinished(t));
+
+export const runningCount = (model: FleetModel): number =>
+  Object.values(model.tasks).filter((t) => !isFinished(t)).length;
+
+export type Tone = "ok" | "warn" | "bad" | "info" | "muted";
+
+export const runnerTone = (status: FleetRunner["status"]): Tone =>
+  status === "healthy" ? "ok" : status === "unreachable" ? "bad" : "warn";
+
+export const taskTone = (state: FleetTaskState): Tone => {
+  switch (state) {
+    case "completed":
+      return "ok";
+    case "failed":
+    case "rejected":
+    case "lost":
+      return "bad";
+    case "input-required":
+      return "warn";
+    case "canceled":
+      return "muted";
+    default:
+      return "info";
+  }
+};
+
+/** Last prompt wins over the manifest example: re-running with tweaks is the common case. */
+export const defaultInput = (model: FleetModel, agentKey: string): string =>
+  runsOf(model, agentKey)[0]?.prompt ?? model.agents?.[agentKey]?.input?.example ?? "";
+
+/** Newest artifact first, so a final summary shows above the raw data it was built from. */
+export const artifactsNewestFirst = (task: FleetTask) => [...task.artifacts].reverse();
+
+export const ago = (now: number, at: number): string => {
+  const sec = Math.max(0, Math.round((now - at) / 1000));
+  if (sec < 5) return "just now";
+  if (sec < 60) return `${sec}s ago`;
+  if (sec < 3600) return `${Math.round(sec / 60)}m ago`;
+  if (sec < 86_400) return `${Math.round(sec / 3600)}h ago`;
+  return `${Math.round(sec / 86_400)}d ago`;
+};
+
+export const duration = (ms: number): string => {
+  const sec = Math.max(0, Math.round(ms / 1000));
+  return sec < 60 ? `${sec}s` : `${Math.floor(sec / 60)}m ${String(sec % 60).padStart(2, "0")}s`;
+};
+
+export const runnerHealth = (model: FleetModel, r: FleetRunner): string => {
+  if (r.status === "unreachable") return `retry in ${Math.max(0, Math.round((r.nextCheckAt - model.now) / 1000))}s`;
+  if (r.lastSeenAt === null) return "checking…";
+  return `seen ${ago(model.now, r.lastSeenAt)}`;
+};
+
+/** Finished runs nobody has dealt with yet, newest first (same rule as the Controller). */
+export const inboxOf = (model: FleetModel): FleetTask[] =>
+  Object.values(model.tasks)
+    .filter((t) => isFinished(t) && !t.ackedAt)
+    .sort((a, b) => b.updatedAt - a.updatedAt);
+
+export const chatsOf = (model: FleetModel): FleetChat[] =>
+  Object.values(model.chats ?? {}).sort((a, b) => b.updatedAt - a.updatedAt);
+
+export const inputLabel = (agent: FleetAgent | undefined): string => agent?.input?.label || "Input";
+
+/** Card heading for an inbox item: what was asked, in the agent's own words. */
+export const runTitle = (model: FleetModel, task: FleetTask): string => {
+  const agent = agentOfTask(model, task);
+  if (!task.prompt) return `Your ${(agent?.name ?? task.agent).toLowerCase()}`;
+  return `${inputLabel(agent)}: ${task.prompt}`;
+};
+
+/** Where a runner is; falls back to its host when it doesn't say. */
+export const runnerLocation = (r: FleetRunner): string => {
+  if (r.location) return r.location;
+  try {
+    return new URL(r.url).host;
+  } catch {
+    return r.url;
+  }
+};
+
+export const RUN_STRIP_LENGTH = 10;
+
+/** Oldest-to-newest outcomes of the last runs, for the agent card's history strip. */
+export const runStrip = (model: FleetModel, agentKey: string): FleetTask[] =>
+  runsOf(model, agentKey).slice(0, RUN_STRIP_LENGTH).reverse();
diff --git a/apps/web/src/components/fleet/use-fleet.ts b/apps/web/src/components/fleet/use-fleet.ts
new file mode 100644
index 0000000..b9d3381
--- /dev/null
+++ b/apps/web/src/components/fleet/use-fleet.ts
@@ -0,0 +1,86 @@
+import { useCallback, useEffect, useState } from "react";
+import {
+  loadFleetConnection,
+  saveFleetConnection,
+  sendFleetIntent,
+  streamFleetModel,
+  FleetError,
+  type FleetConnection,
+  type FleetIntent,
+} from "./fleet-client.js";
+import type { FleetModel } from "./fleet-types.js";
+
+export type FleetLink =
+  | { kind: "unconfigured" }
+  | { kind: "connecting" }
+  | { kind: "live" }
+  | { kind: "retrying"; error: string }
+  | { kind: "rejected"; error: string };
+
+const RETRY_MS = 2_000;
+
+const describe = (e: unknown): string => {
+  if (e instanceof FleetError && e.status === 401) return "The Controller rejected the token.";
+  if (e instanceof FleetError && e.status === 403)
+    return "The Controller doesn't allow this app's origin. Add it to FLEET_ALLOWED_ORIGINS.";
+  if (e instanceof FleetError) return e.message;
+  return "Can't reach the Controller. Is it running?";
+};
+
+/** Auth and origin failures won't fix themselves, so they stop the retry loop. */
+const isFatal = (e: unknown) => e instanceof FleetError && (e.status === 401 || e.status === 403);
+
+export function useFleet() {
+  const [connection, setConnection] = useState<FleetConnection | null>(loadFleetConnection);
+  const [model, setModel] = useState<FleetModel | null>(null);
+  const [link, setLink] = useState<FleetLink>({ kind: "connecting" });
+
+  useEffect(() => {
+    if (!connection) return;
+    const abort = new AbortController();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+
+    const follow = async () => {
+      try {
+        await streamFleetModel(connection, abort.signal, (next) => {
+          setModel(next);
+          setLink({ kind: "live" });
+        });
+        if (!abort.signal.aborted) setLink({ kind: "retrying", error: "The Controller closed the stream." });
+      } catch (e) {
+        if (abort.signal.aborted) return;
+        if (isFatal(e)) return setLink({ kind: "rejected", error: describe(e) });
+        setLink({ kind: "retrying", error: describe(e) });
+      }
+      if (!abort.signal.aborted) timer = setTimeout(() => void follow(), RETRY_MS);
+    };
+
+    setLink({ kind: "connecting" });
+    void follow();
+    return () => {
+      abort.abort();
+      clearTimeout(timer);
+    };
+  }, [connection]);
+
+  const connect = useCallback((next: FleetConnection | null) => {
+    saveFleetConnection(next);
+    setModel(null);
+    setLink(next ? { kind: "connecting" } : { kind: "unconfigured" });
+    setConnection(next);
+  }, []);
+
+  const send = useCallback(
+    async (type: FleetIntent, payload: Record<string, string>): Promise<string | null> => {
+      if (!connection) throw new FleetError("Not connected to a Controller.");
+      try {
+        return await sendFleetIntent(connection, type, payload);
+      } catch (e) {
+        throw new FleetError(describe(e));
+      }
+    },
+    [connection],
+  );
+
+  return { connection, model, link, connect, send };
+}
