+  });
+
+  it("keeps secondary outputs collapsed", () => {
+    const report = {
+      ...jokes,
+      artifacts: [
+        { id: "metrics", name: "metrics", text: "load 4.5" },
+        { id: "summary", name: "summary", text: "All good" },
