+
+describe("ChatPane", () => {
+  it("renders both sides of the conversation", () => {
+    const html = wrap(<ChatPane chat={chat} send={noop} onCreated={() => {}} />);
+    expect([html.includes("hello there"), html.includes("General Kenobi")]).toEqual([true, true]);
