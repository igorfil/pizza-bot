+#!/bin/bash
+# One-command local test of the Agent Fleet screen: pizza-bot api-server on :8080 plus Vite on :5173.
+# Start agent-fleet's dev.sh first; this screen connects to its Controller with the shared dev token.
+set -u
+cd "$(dirname "$0")/.."
+
+[ -d apps/web/node_modules ] || [ -d node_modules ] || npm install
+[ -d packages/core/dist ] || npm run build
+
+trap 'kill 0' EXIT INT TERM
+PORT=8080 PIZZA_DATA_ROOT="${PIZZA_DATA_ROOT:-/tmp/pizza-bot-fleet-dev}" npx tsx apps/api-server/src/index.ts &
+npm run dev -w @pizza-bot/web -- --port 5173 --strictPort &
+
+echo "pizza-bot fleet dev: open http://localhost:5173 and click Agent Fleet (Ctrl-C stops everything)"
+wait
