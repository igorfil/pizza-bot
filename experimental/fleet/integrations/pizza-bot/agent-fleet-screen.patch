+  it("leaves running tasks out of the inbox", () => {
+    const busy = { ...model, tasks: { t1: { ...jokes, state: "working" as const } } };
+    expect(wrap(<InboxView model={busy} send={noop} onOpenChat={() => {}} />)).toContain("All caught up");
