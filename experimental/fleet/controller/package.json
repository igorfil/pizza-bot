{
  "name": "@pizza-bot/fleet-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental fleet backend: headless Controller for agents on local and remote runners (A2A).",
  "bin": {
    "fleet-controller": "./dist/main.js"
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -b",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1173.0",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.0",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15"
  }
}
